{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc compilar arquivo ativo",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compila o arquivo C ativo com gcc no Windows."
        },
        {
            "label": "C: compilar e executar arquivo ativo",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\run-active-c.ps1",
                "${file}",
                "${workspaceFolder}",
                "${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "test",
            "detail": "Compila o arquivo C ativo e executa no terminal integrado."
        }
    ],
    "version": "2.0.0"
}
