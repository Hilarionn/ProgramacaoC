{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C (gcc)",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run C (terminal integrado)",
      "type": "shell",
      "command": "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe",
      "dependsOn": "Build C (gcc)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}